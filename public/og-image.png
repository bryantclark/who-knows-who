<svg width="512" height="512" viewBox="0 0 512 512" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="512" height="512" rx="128" fill="url(#bg_gradient)"/>
  
  <!-- Neural Net Connections - Darker Orange for contrast -->
  <g stroke="#EA580C" stroke-opacity="0.6" stroke-width="12" stroke-linecap="round">
    <!-- Input to Hidden -->
    <line x1="140" y1="180" x2="256" y2="256" />
    <line x1="140" y1="332" x2="256" y2="256" />
    
    <!-- Hidden to Output -->
    <line x1="256" y1="256" x2="372" y2="180" />
    <line x1="256" y1="256" x2="372" y2="332" />
  </g>

  <!-- Nodes - Orange with White Border -->
  <g fill="#F97316" stroke="white" stroke-width="6">
    <!-- Input Layer -->
    <circle cx="140" y1="180" r="32" />
    <circle cx="140" y1="332" r="32" />

    <!-- Hidden Layer -->
    <circle cx="256" y1="256" r="42" />

    <!-- Output Layer -->
    <circle cx="372" y1="180" r="32" />
    <circle cx="372" y1="332" r="32" />
  </g>

  <!-- Pulse Effect on Central Node -->
  <circle cx="256" cy="256" r="60" stroke="#F97316" stroke-width="3" stroke-opacity="0.4"/>
  
  <defs>
    <linearGradient id="bg_gradient" x1="0" y1="0" x2="512" y2="512" gradientUnits="userSpaceOnUse">
      <stop stop-color="#FFFFFF"/>
      <stop offset="1" stop-color="#F1F5F9"/> <!-- Slate 100 -->
    </linearGradient>
  </defs>
</svg>
